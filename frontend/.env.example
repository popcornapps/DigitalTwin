# Auth is handled entirely server-side now (backend/app/routers/auth.py) -
# the browser never talks to Azure AD directly, so there's nothing Entra-
# related to configure here. See src/context/AuthContext.tsx.

# Backend API base URL - relative so it always resolves against whatever
# origin served the page: in dev, the Vite proxy (vite.config.ts) forwards
# /api/* to http://localhost:8000; in prod, frontend+backend are served from
# the same origin (e.g. a single-Docker-container setup).
VITE_API_BASE_URL=/api
