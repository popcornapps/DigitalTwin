# Azure OpenAI - powers the Process Parameter Deviation Agent's reasoning
# layer (Explain/Recommend). Copy this file to `.env` (already gitignored)
# and fill in your real values. If left unset, the agent falls back to a
# deterministic heuristic instead of failing - see app/live/llm_agent.py.

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-08-01-preview
