# Azure OpenAI - powers the Process Parameter Deviation Agent's reasoning
# layer (Explain/Recommend). Copy this file to `.env` (already gitignored)
# and fill in your real values. If left unset, the agent falls back to a
# deterministic heuristic instead of failing - see app/live/llm_agent.py.

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-08-01-preview

DATABASE_URL=postgresql://username:password@localhost:5432/digital_twin

# Live-batch simulation speed: 'demo' (6 sec/sim-minute, normal pace) or
# 'accelerated' (2 sec/sim-minute, fast testing).
LIVE_BATCH_SPEED_PROFILE=demo

# Microsoft Entra ID (Azure AD) - server-side (confidential client)
# Authorization Code flow. The backend itself is the OAuth client: it holds
# a client secret and exchanges the auth code for tokens at
# ENTRA_REDIRECT_URI (see app/routers/auth.py). Tenant/Client ID are not
# secrets, but ENTRA_CLIENT_SECRET IS a real secret - never commit it, never
# expose it to the frontend.
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Where the backend sends the browser after login/logout completes.
FRONTEND_URL=http://localhost:5173

# Session cookie set by app/routers/auth.py after a successful login -
# validated by app/auth.py's get_current_user on every protected route.
# Sessions live in an in-memory store (app/session_store.py) - lost on
# backend restart, single-process only (no Redis/etc for this POC's scale).
SESSION_COOKIE_NAME=dt_session
SESSION_TTL_HOURS=8
# 'true' in prod (HTTPS) - 'false' for plain http://localhost dev.
COOKIE_SECURE=false